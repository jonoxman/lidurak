FROM node:22-bookworm-slim

# Install OpenJDK 17, gnupg, curl, git, tmux, and build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl ca-certificates gnupg tmux python3 build-essential \
    openjdk-17-jdk-headless \
    && rm -rf /var/lib/apt/lists/*

# Install sbt (Scala Build Tool) from official Debian repo
RUN echo "deb https://repo.scala-sbt.org/scalasbt/debian all main" | tee /etc/apt/sources.list.d/sbt.list \
    && curl -sL "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x2EE0EA64E40A89B84B2DF73499E82A75642AC823" | gpg --dearmor -o /etc/apt/trusted.gpg.d/scalasbt-release.gpg \
    && apt-get update && apt-get install -y sbt \
    && rm -rf /var/lib/apt/lists/*

# Install FreeBuff CLI globally
RUN npm install -g freebuff

# Pre-create config and sbt/ivy cache directories owned by 'node' (UID 1000)
RUN mkdir -p /home/node/.config /home/node/.sbt /home/node/.cache \
    && chown -R node:node /home/node

USER node
WORKDIR /workspace

CMD ["tmux", "new-session", "-d", "-s", "agent", "bash"]
