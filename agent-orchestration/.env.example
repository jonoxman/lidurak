# Lidurak Agent Orchestration Environment & Credentials (DO NOT COMMIT .env TO GIT)
# Copy this file to agent-orchestration/.env and populate via ./agent-orchestration/save-auth.sh

# Dedicated Git identity for all automated agent commits & merges
AGENT_GIT_NAME="Lidurak Agent Bot"
AGENT_GIT_EMAIL="agent-bot@lidurak.local"

# Optional: GitHub Personal Access Token for a separate bot GitHub account
AGENT_GH_TOKEN=""

# Email Notification Settings (Uses Gmail STARTTLS by default; create a 16-char App Password at https://myaccount.google.com/apppasswords)
ALERT_EMAIL_TO=""
ALERT_SMTP_USER=""
ALERT_SMTP_PASS=""
ALERT_SMTP_HOST="smtp.gmail.com"
ALERT_SMTP_PORT="587"

# Optional: Direct Codebuff / FreeBuff API key
CODEBUFF_API_KEY=""

# Automatically populated by ./agent-orchestration/save-auth.sh
FREEBUFF_AUTH_B64=""