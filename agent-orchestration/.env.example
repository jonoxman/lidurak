# Lidurak Agent Orchestration Environment & Credentials (DO NOT COMMIT .env TO GIT)
# Copy this file to agent-orchestration/.env and populate via ./agent-orchestration/save-auth.sh

# Dedicated Git identity for all automated agent commits & merges (Task 8)
AGENT_GIT_NAME="Lidurak Agent Bot"
AGENT_GIT_EMAIL="agent-bot@lidurak.local"

# Optional: GitHub Personal Access Token for a separate bot GitHub account (for PR creation/merges)
AGENT_GH_TOKEN=""

# Optional: Direct Codebuff / FreeBuff API key if using key-based auth
CODEBUFF_API_KEY=""

# Automatically populated by ./agent-orchestration/save-auth.sh (Base64 tar of /home/node/.config)
FREEBUFF_AUTH_B64=""
